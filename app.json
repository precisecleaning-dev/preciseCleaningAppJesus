{
  "expo": {
    "name": "Precise Cleaning",
    "slug": "precise-crew",
    "scheme": "precisecrew",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo-mark-white.png",
      "resizeMode": "contain",
      "backgroundColor": "#1570EF"
    },
    "ios": {
      "bundleIdentifier": "com.precisecleaningtx.crew",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Precise Cleaning usa la cámara para tomar las fotos Before/After de cada casa.",
        "NSPhotoLibraryUsageDescription": "Precise Cleaning necesita acceso a tus fotos para cargar las fotos Before/After de cada casa.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.precisecleaningtx.crew",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "Precise Cleaning usa la cámara para tomar las fotos Before/After de cada casa.",
          "photosPermission": "Precise Cleaning necesita acceso a tus fotos para cargar las fotos Before/After de cada casa."
        }
      ],
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1570EF",
          "image": "./assets/logo-mark-white.png",
          "imageWidth": 120
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
